<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shawarma N' Spice | Amrapali, Thane West</title>
    <meta name="description" content="Big flavours. Freshly made. A local shawarma counter in Amrapali, Thane West. Loaded wraps, crispy bites, and coolers worth coming back for.">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,700&family=Playfair+Display:ital,wght@1,600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    
    <style>
        /* CSS Reset & Variables */
        :root {
            --bg-cream: #FAF7F2;
            --bg-cream-dark: #F2EDE4;
            --text-dark: #1A1A1A;
            --text-light: #4A4A4A; /* Slightly darkened for better contrast */
            --accent-orange: #E85D26;
            --accent-orange-hover: #D14F1D;
            --font-heading: 'Space Grotesk', sans-serif;
            --font-serif: 'Playfair Display', serif;
            --font-body: 'DM Sans', sans-serif;
            --border-radius: 16px; /* Softer cards */
            --transition: 0.25s ease;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-body);
            background-color: var(--bg-cream);
            color: var(--text-dark);
            line-height: 1.6;
            overflow-x: hidden;
        }

        img {
            max-width: 100%;
            display: block;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        /* Typography */
        h1, h2, h3, h4 {
            font-family: var(--font-heading);
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -0.02em;
        }

        .serif {
            font-family: var(--font-serif);
            font-style: italic;
            font-weight: 600;
        }

        .text-orange {
            color: var(--accent-orange);
        }

        /* Layout */
        .container {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
        }

        section {
            padding: 80px 0;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 14px 28px;
            font-family: var(--font-heading);
            font-weight: 500;
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            border-radius: 6px;
        }

        .btn-primary {
            background-color: var(--accent-orange);
            color: #fff;
        }

        .btn-primary:hover {
            background-color: var(--accent-orange-hover);
            transform: translateY(-2px);
        }

        .btn-outline {
            background-color: transparent;
            color: var(--text-dark);
            border: 1px solid var(--text-dark);
        }

        .btn-outline:hover {
            background-color: var(--text-dark);
            color: var(--bg-cream);
            transform: translateY(-2px);
        }

        .btn-black {
            background-color: var(--text-dark);
            color: #fff;
        }

        .btn-black:hover {
            background-color: #333;
            transform: translateY(-2px);
        }

        /* Header */
        header {
            position: sticky;
            top: 0;
            background-color: rgba(250, 247, 242, 0.95);
            backdrop-filter: blur(10px);
            z-index: 1000;
            border-bottom: 1px solid rgba(0,0,0,0.05);
            padding: 16px 0;
            transition: var(--transition);
        }

        .header-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 40px;
            height: 40px;
            background-color: var(--text-dark);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-orange);
            font-size: 1.2rem;
        }

        .logo-text {
            display: flex;
            flex-direction: column;
            line-height: 1.1;
        }

        .logo-text span:first-child {
            font-family: var(--font-heading);
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: 0.05em;
        }

        .logo-text span:last-child {
            font-family: var(--font-heading);
            font-weight: 500;
            font-size: 0.8rem;
            color: var(--accent-orange);
            letter-spacing: 0.1em;
        }

        nav {
            display: flex;
            align-items: center;
            gap: 32px;
        }

        nav a {
            font-family: var(--font-heading);
            font-size: 0.85rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-light);
            transition: var(--transition);
        }

        nav a:hover {
            color: var(--accent-orange);
        }

        .mobile-menu-btn {
            display: none;
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--text-dark);
        }

        /* Hero Section */
        .hero {
            padding: 60px 0 80px;
            display: flex;
            align-items: center;
            gap: 60px;
        }

        .hero-content {
            flex: 1;
        }

        .hero-tag {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: var(--font-heading);
            font-size: 0.8rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            color: var(--text-light);
            margin-bottom: 24px;
        }

        .hero-tag::before {
            content: '';
            display: block;
            width: 40px;
            height: 1px;
            background-color: var(--accent-orange);
        }

        .hero h1 {
            font-size: 5rem;
            margin-bottom: 8px;
        }

        .hero h1 .serif {
            font-size: 6rem;
            display: block;
            margin-top: -10px;
        }

        .hero p {
            font-size: 1.1rem;
            color: var(--text-light);
            max-width: 480px;
            margin-bottom: 40px;
            margin-top: 24px;
        }

        .hero-buttons {
            display: flex;
            gap: 16px;
            margin-bottom: 40px;
        }

        .hero-stats {
            display: flex;
            align-items: center;
            gap: 32px;
            font-size: 0.9rem;
            color: var(--text-light);
        }

        .hero-stats span {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .hero-stats .star {
            color: var(--accent-orange);
            font-size: 1.1rem;
        }

        .hero-image {
            flex: 1;
            position: relative;
        }

        .hero-image img {
            width: 100%;
            height: auto;
            border-radius: var(--border-radius);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            position: relative;
            z-index: 2;
        }

        .hero-image::after {
            content: '';
            position: absolute;
            bottom: -20px;
            right: -20px;
            width: 100%;
            height: 100%;
            background-color: var(--accent-orange);
            border-radius: var(--border-radius);
            z-index: 1;
        }

        .hero-badge {
            position: absolute;
            bottom: 30px;
            left: -30px;
            background-color: var(--text-dark);
            color: #fff;
            padding: 16px 24px;
            z-index: 3;
            border-radius: 6px;
            font-family: var(--font-heading);
            font-size: 0.9rem;
            font-weight: 700;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .hero-badge span {
            display: block;
            font-size: 0.7rem;
            font-weight: 500;
            color: var(--accent-orange);
            letter-spacing: 0.1em;
        }

        /* Marquee Banner */
        .marquee-banner {
            background-color: var(--text-dark);
            color: #fff;
            padding: 16px 0;
            overflow: hidden;
            white-space: nowrap;
            display: flex;
            align-items: center;
        }

        .marquee-content {
            display: flex;
            animation: scroll 30s linear infinite;
        }

        .marquee-content span {
            font-family: var(--font-heading);
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            padding: 0 40px;
            display: flex;
            align-items: center;
            gap: 40px;
        }

        .marquee-content span::after {
            content: '✦';
            color: var(--accent-orange);
            font-size: 1.2rem;
        }

        @keyframes scroll {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }

        /* Menu Section */
        .menu-section {
            background-color: var(--bg-cream);
        }

        .menu-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 40px;
        }

        .menu-header-left h2 {
            font-size: 3.5rem;
            margin-bottom: 8px;
        }

        .menu-header-left h2 .serif {
            display: block;
            font-size: 4.5rem;
            margin-top: -15px;
        }

        .menu-header-right {
            max-width: 320px;
            font-size: 0.9rem;
            color: var(--text-light);
            line-height: 1.5;
        }

        /* Menu Controls */
        .menu-controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 32px;
            padding-bottom: 16px;
            border-bottom: 1px solid rgba(0,0,0,0.1);
        }

        .menu-tabs {
            display: flex;
            gap: 24px;
            overflow-x: auto;
            padding-bottom: 4px;
        }

        .menu-tab {
            font-family: var(--font-heading);
            font-size: 0.9rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-light);
            background: none;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: var(--transition);
            padding: 8px 0;
            white-space: nowrap;
        }

        .menu-tab:hover, .menu-tab.active {
            color: var(--accent-orange);
        }

        .menu-tab::after {
            content: '↗';
            font-size: 0.8rem;
        }

        .search-box {
            position: relative;
            width: 100%;
            max-width: 300px;
        }

        .search-box input {
            width: 100%;
            padding: 10px 16px 10px 40px;
            border: 1px solid rgba(0,0,0,0.1);
            border-radius: 6px;
            font-family: var(--font-body);
            font-size: 0.9rem;
            background-color: #fff;
            transition: var(--transition);
        }

        .search-box input:focus {
            outline: none;
            border-color: var(--accent-orange);
            box-shadow: 0 0 0 3px rgba(232, 93, 38, 0.1);
        }

        .search-box .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-light);
            font-size: 1rem;
        }

        /* Menu Grid */
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .menu-category {
            background: #fff;
            border-radius: var(--border-radius);
            padding: 24px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.03);
            border: 1px solid rgba(0,0,0,0.04);
            transition: transform var(--transition);
        }

        .menu-category:hover {
            transform: translateY(-2px);
        }

        .menu-category h3 {
            font-family: var(--font-heading);
            font-size: 1.1rem;
            font-weight: 700;
            text-transform: uppercase;
            color: var(--accent-orange);
            margin-bottom: 16px;
            letter-spacing: 0.05em;
            padding-bottom: 8px;
            border-bottom: 1px solid rgba(232, 93, 38, 0.2);
        }

        .menu-items-list {
            display: flex;
            flex-direction: column;
        }

        .menu-item {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            padding: 10px 0;
            border-bottom: 1px dashed rgba(0,0,0,0.08);
            gap: 16px;
        }

        .menu-item:last-child {
            border-bottom: none;
        }

        .menu-item-name {
            font-size: 0.95rem;
            font-weight: 500;
            line-height: 1.4;
        }

        .menu-item-price {
            font-family: var(--font-heading);
            font-weight: 500;
            color: var(--accent-orange);
            font-size: 0.9rem;
            white-space: nowrap;
        }

        .menu-item-price span {
            color: var(--text-light);
            font-size: 0.75rem;
            margin: 0 2px;
        }

        /* Show More/Less */
        .show-more-btn {
            display: block;
            width: 100%;
            text-align: center;
            margin-top: 16px;
            padding: 8px;
            background: none;
            border: 1px solid rgba(0,0,0,0.1);
            border-radius: 6px;
            font-family: var(--font-heading);
            font-size: 0.8rem;
            font-weight: 500;
            text-transform: uppercase;
            color: var(--text-light);
            cursor: pointer;
            transition: var(--transition);
        }

        .show-more-btn:hover {
            background-color: var(--bg-cream-dark);
            color: var(--accent-orange);
            border-color: var(--accent-orange);
        }

        .show-more-btn.hidden {
            display: none;
        }

        .hidden-item {
            display: none !important;
        }

        /* About Section */
        .about-section {
            background-color: #1A1A1A;
            color: #fff;
        }

        .about-inner {
            display: flex;
            align-items: center;
            gap: 80px;
        }

        .about-image {
            flex: 1;
            position: relative;
        }

        .about-image img {
            border-radius: var(--border-radius);
            width: 100%;
            height: auto;
            object-fit: cover;
        }

        .about-image .badge {
            position: absolute;
            bottom: 20px;
            left: 20px;
            background-color: rgba(26, 26, 26, 0.9);
            padding: 12px 20px;
            border-radius: 6px;
            font-family: var(--font-heading);
            font-size: 0.8rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            color: #fff;
        }

        .about-image .badge span {
            display: block;
            color: var(--accent-orange);
            font-size: 0.7rem;
        }

        .about-content {
            flex: 1;
        }

        .about-tag {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: var(--font-heading);
            font-size: 0.8rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            color: #aaa;
            margin-bottom: 24px;
        }

        .about-tag::before {
            content: '';
            display: block;
            width: 40px;
            height: 1px;
            background-color: var(--accent-orange);
        }

        .about-content h2 {
            font-size: 3.5rem;
            margin-bottom: 8px;
        }

        .about-content h2 .serif {
            display: block;
            font-size: 4.5rem;
            margin-top: -15px;
            color: var(--accent-orange);
        }

        .about-content p {
            color: #ccc;
            font-size: 1rem;
            line-height: 1.8;
            margin-bottom: 24px;
            margin-top: 24px;
        }

        .about-rating {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-top: 24px;
            border-top: 1px solid rgba(255,255,255,0.1);
            font-size: 0.9rem;
        }

        .about-rating .star {
            color: var(--accent-orange);
            font-size: 1.2rem;
        }

        .about-rating span {
            color: #aaa;
        }

        /* Location Section */
        .location-section {
            background-color: var(--bg-cream);
        }

        .location-inner {
            display: flex;
            gap: 80px;
            align-items: center;
        }

        .location-content {
            flex: 1;
        }

        .location-tag {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: var(--font-heading);
            font-size: 0.8rem;
            font-weight: 500;
            letter-spacing: 0.1em;
            color: var(--text-light);
            margin-bottom: 24px;
        }

        .location-tag::before {
            content: '';
            display: block;
            width: 40px;
            height: 1px;
            background-color: var(--accent-orange);
        }

        .location-content h2 {
            font-size: 3.5rem;
            margin-bottom: 8px;
        }

        .location-content h2 .serif {
            display: block;
            font-size: 4.5rem;
            margin-top: -15px;
        }

        .location-content p {
            font-size: 1rem;
            color: var(--text-light);
            max-width: 400px;
            margin-bottom: 32px;
            margin-top: 24px;
        }

        .location-card {
            flex: 1;
            background-color: var(--bg-cream-dark);
            padding: 48px;
            border-radius: var(--border-radius);
        }

        .location-card-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 24px;
        }

        .location-icon {
            width: 48px;
            height: 48px;
            background-color: var(--accent-orange);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.2rem;
        }

        .location-card-header h3 {
            font-size: 1.2rem;
        }

        .location-card p {
            color: var(--text-light);
            font-size: 1rem;
            line-height: 1.8;
            margin-bottom: 24px;
        }

        .location-hours {
            display: flex;
            align-items: center;
            gap: 12px;
            padding-top: 24px;
            border-top: 1px solid rgba(0,0,0,0.1);
        }

        .location-hours .icon {
            color: var(--accent-orange);
            font-size: 1.2rem;
        }

        .location-hours div p:first-child {
            font-weight: 500;
            color: var(--text-dark);
            margin-bottom: 2px;
        }

        .location-hours div p:last-child {
            font-size: 0.9rem;
            color: var(--text-light);
        }

        /* Footer */
        footer {
            background-color: var(--text-dark);
            color: #fff;
            padding: 60px 0 30px;
        }

        .footer-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 60px;
        }

        .footer-brand .logo-text span:first-child {
            color: #fff;
        }

        .footer-brand p {
            color: #aaa;
            font-size: 0.9rem;
            margin-top: 16px;
            max-width: 250px;
        }

        .footer-nav {
            display: flex;
            gap: 32px;
        }

        .footer-nav a {
            font-family: var(--font-heading);
            font-size: 0.85rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #aaa;
            transition: var(--transition);
        }

        .footer-nav a:hover {
            color: var(--accent-orange);
        }

        .footer-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 30px;
            border-top: 1px solid rgba(255,255,255,0.1);
            font-size: 0.8rem;
            color: #777;
        }

        .footer-bottom a {
            color: #777;
            transition: var(--transition);
        }

        .footer-bottom a:hover {
            color: var(--accent-orange);
        }

        /* Responsive */
        @media (max-width: 1024px) {
            .hero h1 { font-size: 4rem; }
            .hero h1 .serif { font-size: 5rem; }
            .menu-header-left h2 { font-size: 2.8rem; }
            .menu-header-left h2 .serif { font-size: 3.8rem; }
            .about-content h2 { font-size: 2.8rem; }
            .about-content h2 .serif { font-size: 3.8rem; }
            .location-content h2 { font-size: 2.8rem; }
            .location-content h2 .serif { font-size: 3.8rem; }
            .menu-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @media (max-width: 768px) {
            .header-inner nav { display: none; }
            .mobile-menu-btn { display: block; }
            .header-inner .btn { display: none; }
            
            .hero {
                flex-direction: column;
                gap: 40px;
                padding: 40px 0;
            }
            .hero h1 { font-size: 3rem; }
            .hero h1 .serif { font-size: 3.8rem; }
            .hero-buttons { flex-direction: column; }
            .hero-image::after { display: none; }
            .hero-badge { left: 10px; bottom: 10px; }
            
            .menu-header { flex-direction: column; align-items: flex-start; gap: 24px; }
            .menu-header-left h2 { font-size: 2.5rem; }
            .menu-header-left h2 .serif { font-size: 3.2rem; }
            
            .about-inner { flex-direction: column; gap: 40px; }
            .about-content h2 { font-size: 2.5rem; }
            .about-content h2 .serif { font-size: 3.2rem; }
            
            .location-inner { flex-direction: column; gap: 40px; }
            .location-content h2 { font-size: 2.5rem; }
            .location-content h2 .serif { font-size: 3.2rem; }
            .location-card { padding: 32px; }
            
            .footer-top { flex-direction: column; gap: 40px; }
            .footer-bottom { flex-direction: column; gap: 16px; text-align: center; }
            
            .menu-grid { grid-template-columns: 1fr; }
            .menu-controls { flex-direction: column; align-items: flex-start; }
            .search-box { max-width: 100%; }
        }

        @media (max-width: 480px) {
            .hero h1 { font-size: 2.5rem; }
            .hero h1 .serif { font-size: 3rem; }
            .hero-stats { flex-direction: column; align-items: flex-start; gap: 12px; }
            .about-content h2 { font-size: 2rem; }
            .about-content h2 .serif { font-size: 2.8rem; }
            .location-content h2 { font-size: 2rem; }
            .location-content h2 .serif { font-size: 2.8rem; }
        }

        /* Mobile Menu Overlay */
        .mobile-menu-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background-color: rgba(250, 247, 242, 0.98);
            backdrop-filter: blur(5px);
            z-index: 2000;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 32px;
            opacity: 0;
