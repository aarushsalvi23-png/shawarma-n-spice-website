    <!-- JavaScript -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Mobile Menu Toggle
            const mobileMenuBtn = document.getElementById('mobileMenuBtn');
            const mobileMenuOverlay = document.getElementById('mobileMenuOverlay');
            const closeMenuBtn = document.getElementById('closeMenuBtn');
            const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

            mobileMenuBtn.addEventListener('click', () => {
                mobileMenuOverlay.classList.add('active');
                document.body.style.overflow = 'hidden';
            });

            const closeMenu = () => {
                mobileMenuOverlay.classList.remove('active');
                document.body.style.overflow = '';
            };

            closeMenuBtn.addEventListener('click', closeMenu);
            mobileNavLinks.forEach(link => {
                link.addEventListener('click', closeMenu);
            });

            // Menu Tabs & Search Functionality
            const menuTabs = document.querySelectorAll('.menu-tab');
            const menuGrids = document.querySelectorAll('.menu-grid');
            const searchInput = document.getElementById('menuSearch');

            // Show More/Less Functionality
            const showMoreBtns = document.querySelectorAll('.show-more-btn');
            showMoreBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    const category = btn.closest('.menu-category');
                    const hiddenItems = category.querySelectorAll('.hidden-item');
                    
                    if (hiddenItems.length > 0) {
                        const isHidden = hiddenItems[0].classList.contains('hidden-item');
                        
                        if (isHidden) {
                            hiddenItems.forEach(item => {
                                item.classList.remove('hidden-item');
                            });
                            btn.textContent = 'Show Less ↑';
                        } else {
                            hiddenItems.forEach(item => {
                                item.classList.add('hidden-item');
                            });
                            btn.textContent = 'Show More ↓';
                        }
                    }
                });
            });

            // Filter function for search
            function filterMenu(query) {
                const lowerQuery = query.toLowerCase().trim();
                const activeGrid = document.querySelector('.menu-grid[style*="display: grid"]');
                
                if (!activeGrid) return;

                if (!lowerQuery) {
                    // Reset to default visibility
                    activeGrid.querySelectorAll('.menu-item').forEach(item => {
                        item.style.display = 'flex'; 
                        // Restore hidden items if they were hidden by search but should be hidden by default
                        if(item.dataset.defaultHidden === 'true') {
                            item.classList.add('hidden-item');
                        } else {
                            item.classList.remove('hidden-item');
                        }
                    });
                    activeGrid.querySelectorAll('.menu-category').forEach(cat => {
                        cat.style.display = 'block';
                    });
                    activeGrid.querySelectorAll('.show-more-btn').forEach(btn => {
                        btn.style.display = 'block';
                        btn.textContent = 'Show More ↓';
                    });
                    return;
                }

                // Filtering logic
                activeGrid.querySelectorAll('.menu-category').forEach(category => {
                    let hasVisible = false;
                    const items = category.querySelectorAll('.menu-item');
                    
                    items.forEach(item => {
                        const name = item.querySelector('.menu-item-name').textContent.toLowerCase();
                        if (name.includes(lowerQuery)) {
                            item.style.display = 'flex';
                            item.classList.remove('hidden-item');
                            hasVisible = true;
                        } else {
                            item.style.display = 'none';
                        }
                    });
                    
                    if (hasVisible) {
                        category.style.display = 'block';
                        const btn = category.querySelector('.show-more-btn');
                        if(btn) btn.style.display = 'none'; // hide show more during search
                    } else {
                        category.style.display = 'none';
                    }
                });
            }

            // Setup Tab switching
            menuTabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    menuTabs.forEach(t => t.classList.remove('active'));
                    tab.classList.add('active');

                    menuGrids.forEach(grid => grid.style.display = 'none');
                    
                    const targetId = tab.getAttribute('data-target');
                    const targetGrid = document.getElementById(targetId);
                    if (targetGrid) {
                        targetGrid.style.display = 'grid';
                    }
                    
                    if (searchInput) {
                        searchInput.value = '';
                        filterMenu('');
                    }
                });
            });

            // Setup Search listener
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    filterMenu(e.target.value);
                });
            }
        });
    </script>
</body>
</html>
